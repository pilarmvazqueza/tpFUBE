            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"items\": [\n    {\n      \"productoId\": {{productoId}},\n      \"cantidad\": 100000,\n      \"precioUnitario\": 1500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{pedidosUrl}}/api/v1/pedidos",
