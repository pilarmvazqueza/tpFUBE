          "name": "3.1 Ejecutar job de expiracion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('devuelve el resumen de la corrida', function () {",
                  "    const resumen = pm.response.json();",
                  "    pm.expect(resumen.estado).to.be.a('string');",
                  "    pm.expect(resumen.leidos).to.be.a('number');",
                  "    pm.expect(resumen.expirados).to.be.a('number');",
                  "});"
