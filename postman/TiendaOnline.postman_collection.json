          },
          "response": []
        },
        {
          "name": "1.8 Cancelar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('estado CANCELADO', function () { pm.expect(pm.response.json().estado).to.eql('CANCELADO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/api/v1/pedidos/{{pedidoId}}/cancelacion",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{pedidoId}}",
                "cancelacion"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.9 Stock luego de cancelar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const inicial = Number(pm.collectionVariables.get('stockInicial'));",
                  "pm.test('la reserva se libero y el stock volvio al inicial', function () { pm.expect(pm.response.json()).to.eql(inicial); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventarioUrl}}/api/v1/inventario/productos/{{productoId}}/cantidad-disponible",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventario",
                "productos",
                "{{productoId}}",
                "cantidad-disponible"
              ]
            }
          },
          "response": []
        }
      ]
