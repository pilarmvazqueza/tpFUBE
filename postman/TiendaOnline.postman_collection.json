                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('detalla el campo invalido', function () {",
                  "    pm.expect(pm.response.json().detalles).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
