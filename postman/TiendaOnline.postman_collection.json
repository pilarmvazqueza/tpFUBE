  "item": [
    {
      "name": "1 - Flujo sin errores",
      "item": [
        {
          "name": "1.1 Crear cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const cliente = pm.response.json();",
                  "pm.test('devuelve id y fechaAlta', function () {",
                  "    pm.expect(cliente.id).to.be.a('number');",
                  "    pm.expect(cliente.fechaAlta).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('clienteId', cliente.id);",
                  "pm.collectionVariables.set('traceId', pm.response.headers.get('X-Trace-Id'));",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const siguiente = Number(pm.collectionVariables.get('contador') || 0) + 1;\r",
                  "pm.collectionVariables.set('contador', siguiente);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"cliente{{contador}}\",\n  \"email\": \"cliente{{contador}}@mail.com\"\n}"
            },
            "url": {
              "raw": "{{clientesUrl}}/api/v1/clientes",
              "host": [
                "{{clientesUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clientes"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Consultar stock inicial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const stock = pm.response.json();",
                  "pm.test('stock suficiente para el pedido (>= 2)', function () { pm.expect(stock).to.be.at.least(2); });",
                  "pm.collectionVariables.set('stockInicial', stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventarioUrl}}/api/v1/inventario/productos/{{productoId}}/cantidad-disponible",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventario",
                "productos",
                "{{productoId}}",
                "cantidad-disponible"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const pedido = pm.response.json();",
                  "pm.test('estado CREADO y monto calculado', function () {",
                  "    pm.expect(pedido.estado).to.eql('CREADO');",
                  "    pm.expect(pedido.montoTotal).to.eql(3000);",
                  "});",
                  "pm.test('responde el header X-Trace-Id', function () {",
                  "    pm.expect(pm.response.headers.get('X-Trace-Id')).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('pedidoId', pedido.id);",
                  "pm.collectionVariables.set('traceId', pm.response.headers.get('X-Trace-Id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"items\": [\n    {\n      \"productoId\": {{productoId}},\n      \"cantidad\": 2,\n      \"precioUnitario\": 1500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{pedidosUrl}}/api/v1/pedidos",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.4 Stock luego del pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const inicial = Number(pm.collectionVariables.get('stockInicial'));",
                  "pm.test('el stock bajo en 2', function () { pm.expect(pm.response.json()).to.eql(inicial - 2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventarioUrl}}/api/v1/inventario/productos/{{productoId}}/cantidad-disponible",
              "host": [
                "{{inventarioUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventario",
                "productos",
                "{{productoId}}",
                "cantidad-disponible"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.5 Consultar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const pedido = pm.response.json();",
                  "pm.test('es el pedido creado', function () {",
                  "    pm.expect(String(pedido.id)).to.eql(pm.collectionVariables.get('pedidoId'));",
                  "    pm.expect(pedido.items).to.have.lengthOf(1);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/api/v1/pedidos/{{pedidoId}}",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{pedidoId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.6 Listar pedidos del cliente (clientes -> pedidos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const pedidos = pm.response.json();",
                  "pm.test('incluye el pedido creado', function () {",
                  "    const ids = pedidos.map(function (p) { return String(p.id); });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('pedidoId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{clientesUrl}}/api/v1/clientes/{{clienteId}}/pedidos",
              "host": [
                "{{clientesUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clientes",
                "{{clienteId}}",
                "pedidos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.7 Confirmar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('estado CONFIRMADO', function () { pm.expect(pm.response.json().estado).to.eql('CONFIRMADO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/api/v1/pedidos/{{pedidoId}}/confirmacion",
              "host": [
                "{{pedidosUrl}}"
